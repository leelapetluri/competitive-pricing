    {
      "parameters": {
        "jsCode": "const ourPrice = Number($json.our_price);\nconst competitorPrice = Number($json.competitor_price);\nconst costPrice = Number($json.cost_price);\nconst marginPercent = Number($json.minimum_margin_percent);\n\nconst minimumSafePrice = costPrice * (1 + marginPercent / 100);\n\nreturn [{\n  json: {\n    our_price: ourPrice,\n    competitor_price: competitorPrice,\n    cost_price: costPrice,\n    minimum_margin_percent: marginPercent,\n    minimum_safe_price: minimumSafePrice\n  }\n}];"
      },
