    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst html =\n  input.body ||\n  input.data ||\n  input.html ||\n  JSON.stringify(input);\n\nconst matches = [...html.matchAll(/(?:₹|Rs\\.?|INR)\\s*([\\d,]+)/gi)]\n  .map(m => Number(m[1].replace(/,/g, \"\")))\n  .filter(p => p >= 10000 && p <= 30000);\n\nreturn [{\n  json: {\n    competitor_price: matches[0] || null,\n    prices_found: matches\n  }\n}];"
      },
