    {
      "parameters": {
        "jsCode": "const html = $input.first().json.body || $input.first().json.data || \"\";\n\nconst prices = [...html.matchAll(/₹\\s*([\\d,]+)/g)]\n  .map(m => Number(m[1].replace(/,/g, \"\")))\n  .filter(p => p > 100 && p < 1000000);\n\nreturn [\n  {\n    json: {\n      product_price: prices[0] || null\n    }\n  }\n];"
      },
